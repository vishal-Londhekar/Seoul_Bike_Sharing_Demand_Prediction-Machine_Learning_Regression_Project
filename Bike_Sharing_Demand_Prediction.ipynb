   ]
  },
  {
   "cell_type": "code",
   "source": [
    "# Handling Outliers & Outlier treatments\n",
    "sns.boxplot(df['Wind_speed'], color='#FF7F50')"
   ],
   "metadata": {
    "colab": {
     "base_uri": "https://localhost:8080/",
     "height": 516
    },
    "id": "mq8FRLz3WmQz",
    "outputId": "284bd757-4551-40f1-a87c-7e8624607e18"
   },
   "outputs": []
  },
  {
   "cell_type": "code",
   "metadata": {
    "id": "ybFqccNtOAdW"
   },
   "outputs": [],
   "source": [
    "# Finding the IQR\n",
    "percentile25 = df['Wind_speed'].quantile(0.25)\n",
    "percentile75 = df['Wind_speed'].quantile(0.75)\n",
    "iqr = percentile75 - percentile25\n",
    "upper_limit = percentile75 + 1.5 * iqr\n",
    "lower_limit = percentile25 - 1.5 * iqr"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {
    "id": "9QUqJvqZOPz3"
   },
   "outputs": [],
   "source": [
    "# Capping\n",
    "df['Wind_speed'] = np.where(\n",
    "    df['Wind_speed'] > upper_limit,\n",
    "    upper_limit,\n",
    "    np.where(\n",
    "        df['Wind_speed'] < lower_limit,\n",
    "        lower_limit,\n",
    "        df['Wind_speed']\n",
    "    )\n",
    ")"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {
